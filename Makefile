#AI generated bcs im really lazy to do that
# Compiler and flags
CC      := gcc
CFLAGS  := -Wall -Wextra -g -MMD -MP -Isrc/core
LDFLAGS := $(shell pkg-config --libs raylib) -lm

# Sources -> objects (src/core/foo.c -> build/core/foo.o)
FRONTEND ?= raylib
SRCS := $(wildcard src/core/*.c) src/frontend/$(FRONTEND)_main.c
OBJS := $(patsubst src/%.c,build/%.o,$(SRCS))
DEPS := $(OBJS:.o=.d)

TARGET := gb

.PHONY: all clean run

all: $(TARGET)

# Link all objects into the executable
$(TARGET): $(OBJS)
	$(CC) $^ -o $@ $(LDFLAGS)

# Compile each .c into a .o (creates the output folder if needed)
build/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# Usage: make run ROM=roms/tetris.gb
run: $(TARGET)
	./$(TARGET) $(ROM)

clean:
	rm -rf build $(TARGET)

# Header dependencies generated by -MMD -MP
-include $(DEPS)